    "import json\n",
    "import os\n",
    "import time\n",
    "\n",
    "import pandas as pd\n",
    "import requests"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "731bb528-d450-4cc6-b03d-203d83f9b18d",
   "metadata": {},
   "outputs": [],
   "source": [
    "BASE = \"https://wcc.sc.egov.usda.gov/awdbRestApi/services/v1\"\n",
    "HEADERS = {\"User-Agent\": \"info4617 snow project - Evan Bardinelli, evan.bardinelli@colorado.edu\"}  \n",
    "PAUSE = 1.0                      \n",
    "START, END = \"2025-12-01\", \"2026-04-01\"\n",
    "FETCH_FROM = \"2025-11-30\"         \n",
    "\n",
    "RESORTS = {\n",
    "    \"vail\":     \"Vail Mountain\",     \n",
    "    \"copper\":   \"Copper Mountain\",   \n",
    "    \"loveland\": \"Loveland Basin\",    \n",
    "}\n",
    "\n",
    "os.makedirs(\"data/raw/snotel\", exist_ok=True)\n",
    "os.makedirs(\"data/clean\", exist_ok=True)\n",
    "\n",
    "\n",
    "def get(url, params):\n",
    "    \"\"\"One polite request: identify ourselves, check the status, then pause.\"\"\"\n",
    "    r = requests.get(url, params=params, headers=HEADERS, timeout=60)\n",
    "    print(f\"  HTTP {r.status_code}  {r.url}\")\n",
    "    r.raise_for_status()\n",
    "    time.sleep(PAUSE)\n",
    "    return r.json()\n",
    "\n",
    "\n",
    "rows = []\n",
    "for resort, station_name in RESORTS.items():\n",
    "    print(resort)\n",
    "\n",
    "  \n",
    "    stations = get(f\"{BASE}/stations\",\n",
    "                   {\"stationTriplets\": \"*:CO:SNTL\", \"stationNames\": station_name})\n",
    "    station = next(s for s in stations if s[\"name\"].lower() == station_name.lower())\n",
    "    triplet = station[\"stationTriplet\"]\n",
    "    print(f\"  {station_name} = {triplet}, {station.get('elevation')} ft\")\n",
    "\n",
    "   \n",
    "    data = get(f\"{BASE}/data\", {\n",
    "        \"stationTriplets\": triplet,\n",
    "        \"elements\": \"SNWD,WTEQ\",\n",
    "        \"duration\": \"DAILY\",\n",
    "        \"beginDate\": FETCH_FROM,\n",
    "        \"endDate\": END,\n",
    "    })\n",
    "\n",
    "   \n",
    "    with open(f\"data/raw/snotel/{resort}.json\", \"w\") as f:\n",
    "        json.dump({\"station\": station, \"response\": data}, f, indent=1)\n",
    "\n",
    "   \n",
    "    for block in data[0][\"data\"]:\n",
    "        element = block[\"stationElement\"][\"elementCode\"]\n",
    "        for v in block[\"values\"]:\n",
    "            rows.append({\"resort\": resort, \"station\": station_name,\n",
    "                         \"triplet\": triplet, \"date\": v[\"date\"][:10],\n",
    "                         \"element\": element, \"value\": v.get(\"value\")})"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "e0cb1e3d-ca06-41a1-98e2-d3ce75515e17",
   "metadata": {},
   "outputs": [],
   "source": [
    "df = (pd.DataFrame(rows)\n",
    "        .pivot_table(index=[\"resort\", \"station\", \"triplet\", \"date\"],\n",
    "                     columns=\"element\", values=\"value\", aggfunc=\"first\")\n",
    "        .reset_index()\n",
    "        .rename(columns={\"SNWD\": \"depth_in\", \"WTEQ\": \"swe_in\"}))\n",
    "df.columns.name = None\n",
    "df[\"date\"] = pd.to_datetime(df[\"date\"])\n",
    "df = df.sort_values([\"resort\", \"date\"])\n",
    "\n",
    "# New snow estimate = day-over-day rise in depth (a drop from settling counts as 0)\n",
    "df[\"depth_change_in\"] = df.groupby(\"resort\")[\"depth_in\"].diff()\n",
    "df[\"new_snow_in\"] = df[\"depth_change_in\"].clip(lower=0)\n",
    "df[\"swe_change_in\"] = df.groupby(\"resort\")[\"swe_in\"].diff().round(1)\n",
    "\n",
    "# Drop the extra Nov 30 day now that the changes are computed\n",
    "df = df[(df[\"date\"] >= START) & (df[\"date\"] <= END)]\n",
    "\n",
    "df.to_csv(\"data/clean/snotel_daily.csv\", index=False)\n",
    "print(f\"\\nSaved {len(df)} station-days to data/clean/snotel_daily.csv\")\n",
    "print(df.groupby(\"resort\").size())\n",
    "print(df.head())"
   ]
